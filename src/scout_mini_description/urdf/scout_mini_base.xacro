<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="scout_mini_base" params="">

    <material name="Gray">
      <color rgba="0.5 0.5 0.5 1"/>
    </material>

    <!-- Base link -->
    <link name="base_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="21.0"/>
        <inertia
          ixx="0.3787"
          ixy="0"
          ixz="0"
          iyy="0.5075"
          iyz="0"
          izz="0.7462"/>
      </inertial>
    </link>

    

    <link name="base_visual">
      <visual>
        <origin rpy="1.57 0 -1.57" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://scout_mini_description/meshes/scout_mini_base_link2.dae"/>
        </geometry>
      </visual>

      <collision>
        <origin rpy="1.57 0 -1.57" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://scout_mini_description/meshes/scout_mini_base_link2.dae"/>
        </geometry>
      </collision>
    </link>

    <joint name="base_link_to_visual" type="fixed">
      <parent link="base_link"/>
      <child link="base_visual"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="inertial_joint" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="base_link"/>
      <child link="inertial_link"/>
    </joint>

    <!-- Wheels -->
    <link name="front_left_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia
          ixx="0.00181"
          ixy="0"
          ixz="0"
          iyy="0.00181"
          iyz="0"
          izz="0.0032"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://scout_mini_description/meshes/wheel.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder radius="0.08" length="0.05"/>
        </geometry>
      </collision>
    </link>

    <joint name="front_left_wheel" type="continuous">
      <parent link="base_link"/>
      <child link="front_left_wheel_link"/>
      <origin rpy="-1.57 0 0" xyz="0.2319755 0.2082515 -0.100998"/>
      <axis rpy="0 0 0" xyz="0 0 1"/>
    </joint>

    <link name="rear_left_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia
          ixx="0.00181"
          ixy="0"
          ixz="0"
          iyy="0.00181"
          iyz="0"
          izz="0.0032"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://scout_mini_description/meshes/wheel.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder radius="0.08" length="0.05"/>
        </geometry>
      </collision>
    </link>

    <joint name="rear_left_wheel" type="continuous">
      <parent link="base_link"/>
      <child link="rear_left_wheel_link"/>
      <origin rpy="-1.57 0 0" xyz="-0.2319755 0.2082515 -0.100998"/>
      <axis rpy="0 0 0" xyz="0 0 1"/>
    </joint>

    <link name="front_right_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia
          ixx="0.00181"
          ixy="0"
          ixz="0"
          iyy="0.00181"
          iyz="0"
          izz="0.0032"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://scout_mini_description/meshes/wheel.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder radius="0.08" length="0.05"/>
        </geometry>
      </collision>
    </link>

    <joint name="front_right_wheel" type="continuous">
      <parent link="base_link"/>
      <child link="front_right_wheel_link"/>
      <origin rpy="1.57 0 0" xyz="0.2319755 -0.2082515 -0.099998"/>
      <axis rpy="0 0 0" xyz="0 0 -1"/>
    </joint>

    <link name="rear_right_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia
          ixx="0.00181"
          ixy="0"
          ixz="0"
          iyy="0.00181"
          iyz="0"
          izz="0.0032"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://scout_mini_description/meshes/wheel.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder radius="0.08" length="0.05"/>
        </geometry>
      </collision>
    </link>

    <joint name="rear_right_wheel" type="continuous">
      <parent link="base_link"/>
      <child link="rear_right_wheel_link"/>
      <origin rpy="1.57 0 0" xyz="-0.2319755 -0.2082515 -0.099998"/>
      <axis rpy="0 0 0" xyz="0 0 -1"/>
    </joint>

  </xacro:macro>
</robot>
