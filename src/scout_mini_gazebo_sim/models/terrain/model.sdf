<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="terrain">
    <static>true</static>

    <!-- wall -->
    <link name="wall_link">
      <visual name="wall_visual">
        <geometry>
          <mesh>
            <uri>model://terrain/meshes/wall.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="wall_collision">
        <geometry>
          <mesh>
            <uri>model://terrain/meshes/wall.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- 5deg slope -->
    <link name="slope_5_link">
      <pose>2 4 0 0 0 0</pose>
      <visual name="slope_5_visual">
        <geometry>
          <mesh>
            <uri>model://terrain/meshes/5deg_slope.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.6 1.0 0.6 1</ambient>
          <diffuse>0.6 1.0 0.6 1</diffuse>
        </material>
      </visual>
      <collision name="slope_5_collision">
        <geometry>
          <mesh>
            <uri>model://terrain/meshes/5deg_slope.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- 10deg slope -->
    <link name="slope_10_link">
      <pose>4 4 0 0 0 0</pose>
      <visual name="slope_10_visual">
        <geometry>
          <mesh>
            <uri>model://terrain/meshes/10deg_slope.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.3 0.9 0.3 1</ambient>
          <diffuse>0.3 0.9 0.3 1</diffuse>
        </material>
      </visual>
      <collision name="slope_10_collision">
        <geometry>
          <mesh>
            <uri>model://terrain/meshes/10deg_slope.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- 15deg slope -->
    <link name="slope_15_link">
      <pose>6 4 0 0 0 0</pose>
      <visual name="slope_15_visual">
        <geometry>
          <mesh>
            <uri>model://terrain/meshes/15deg_slope.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.0 0.75 0.0 1</ambient>
          <diffuse>0.0 0.75 0.0 1</diffuse>
        </material>
      </visual>
      <collision name="slope_15_collision">
        <geometry>
          <mesh>
            <uri>model://terrain/meshes/15deg_slope.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- 30deg slope -->
    <link name="slope_30_link">
      <pose>8 4 0 0 0 0</pose>
      <visual name="slope_30_visual">
        <geometry>
          <mesh>
            <uri>model://terrain/meshes/30deg_slope.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.0 0.45 0.0 1</ambient>
          <diffuse>0.0 0.45 0.0 1</diffuse>
        </material>
      </visual>
      <collision name="slope_30_collision">
        <geometry>
          <mesh>
            <uri>model://terrain/meshes/30deg_slope.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- SLAM feature box 1 -->
    <link name="feature_box_1">
      <pose>3.0 2.0 0.5 0 0 0.3</pose>
      <visual name="feature_box_1_visual">
        <geometry>
          <box>
            <size>0.6 0.4 1.0</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.3 0.3 1</ambient>
          <diffuse>0.8 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <collision name="feature_box_1_collision">
        <geometry>
          <box>
            <size>0.6 0.4 1.0</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- SLAM feature box 2 -->
    <link name="feature_box_2">
      <pose>7.0 7.0 0.4 0 0 -0.6</pose>
      <visual name="feature_box_2_visual">
        <geometry>
          <box>
            <size>0.5 0.8 0.8</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.8 1</ambient>
          <diffuse>0.3 0.3 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="feature_box_2_collision">
        <geometry>
          <box>
            <size>0.5 0.8 0.8</size>
          </box>
        </geometry>
      </collision>
    </link>

  </model>
</sdf>